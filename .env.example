# -----------------------------------------------------------------------------
# ContextGraph - environment template
# Copy to `.env.local` and fill in real values. Never commit real secrets.
# Every variable here is validated at boot time by `src/validations/env.ts`.
# -----------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
NODE_ENV=development
# Public base URL of the deployed application.
APP_URL=http://localhost:3000
# Minimum severity for application logs: debug | info | warn | error
LOG_LEVEL=info

# --- Database (Supabase PostgreSQL) -----------------------------------------
# Required for Phase 2 database features: migrations, seed, repositories.
# The application shell still boots without it (health check, dashboard).
#
# Prisma CLI reads .env; Next.js reads .env.local. Put DATABASE_URL in either
# (both are loaded); use the Supabase connection string from
# Project Settings -> Database -> Connection string (Pooler / Transaction mode):
#   postgresql://user:password@host:6543/db?pgbouncer=true&connection_limit=1
#
# Local development (Docker):
#   docker run -d --name contextgraph-pg -e POSTGRES_USER=postgres \
#     -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=contextgraph \
#     -p 5432:5432 postgres:16-alpine
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contextgraph?schema=public
