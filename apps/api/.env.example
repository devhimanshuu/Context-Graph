# -----------------------------------------------------------------------------
# ContextGraph API — environment template
# Copy to `.env` (gitignored) and fill in real values. Every variable here is
# validated at bootstrap by `packages/config` (Zod).
# -----------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Database (PostgreSQL) --------------------------------------------------
# Prisma CLI reads this from the API's own `.env`. Point it at your local
# PostgreSQL or Supabase project.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contextgraph?schema=public
# Optional direct (non-pooled) connection used by Prisma for migrations.
DIRECT_URL=

# --- Caching & queues -------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Demo seed ----------------------------------------------------------------
# Shared bcrypt-hashed password given to every seeded user (dev/demo only).
# Must match NEXT_PUBLIC_DEMO_PASSWORD in apps/web/.env for the demo login.
SEED_USER_PASSWORD=ContextGraph-demo-2026!

# --- AI providers (optional — enable AI chat) ----------------------------------
# At least one provider must be configured for /ai/chat to work.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# --- Embeddings (semantic retrieval) --------------------------------------------
# EMBEDDING_PROVIDER=OPENAI
# OPENAI_API_KEY=

# --- Authentication (JWT / Passport) ----------------------------------------
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-a-32-byte-random-secret
JWT_ACCESS_TTL=15m

# --- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to call the API (web app + local preview).
CORS_ORIGINS=http://localhost:3000,http://localhost:3102

# --- API documentation ------------------------------------------------------
SWAGGER_ENABLED=true

# --- Observability (OpenTelemetry-ready; disabled unless set) ---------------
# OTLP_ENDPOINT=http://localhost:4318/v1/traces
