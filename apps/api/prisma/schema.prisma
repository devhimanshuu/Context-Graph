/// Usage record for cost and token tracking.
model UsageRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  agentId        String?  @db.Uuid
  workflowId     String?  @db.Uuid
  modelProvider  String
