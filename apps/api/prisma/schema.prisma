/// Custom role within an organization.
model CustomRole {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  permissions    Json         @default("[]")
  isBuiltIn      Boolean      @default(false)
  status         RoleStatus   @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Governance policy with versioning.
model GovernancePolicy {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  type           PolicyType
  version        Int          @default(1)
  status         PolicyStatus @default(DRAFT)
  configuration  Json         @default("{}")
  createdBy      String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name, version])
  @@index([organizationId, type])
  @@index([organizationId, status])
}

/// Registered agent definition with governance controls.
model AgentDefinitionModel {
  id                    String               @id @default(uuid()) @db.Uuid
  organizationId        String               @db.Uuid
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String
  description           String?
  version               Int                  @default(1)
  status                AgentDefinitionStatus @default(DRAFT)
  capabilities          Json                 @default("[]")
  allowedTools          Json                 @default("[]")
  modelProvider         String?
  modelName             String?
  maxIterations         Int                  @default(5)
  maxToolCalls          Int                  @default(10)
  maxTokens             Int                  @default(15000)
  maxCost               Float                @default(1.0)
  maxExecutionDurationMs Int                 @default(300000)
  policyReferences      Json                 @default("[]")
  createdBy             String?              @db.Uuid
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([organizationId, name, version])
  @@index([organizationId, status])
}

/// Model provider configuration per organization.
model ModelProviderConfiguration {
  id                  String           @id @default(uuid()) @db.Uuid
  organizationId      String           @db.Uuid
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider            String
  status              ModelProviderStatus @default(ACTIVE)
  allowedModels       Json             @default("[]")
  blockedModels       Json             @default("[]")
  defaultModel        String?
  fallbackModel       String?
  maxTokensPerRequest Int              @default(128000)
  costPerInputToken   Float            @default(0)
  costPerOutputToken  Float            @default(0)
  metadata            Json             @default("{}")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([organizationId, provider])
  @@index([organizationId])
}

/// Budget for cost control.
model Budget {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           BudgetType
  targetType     String?
  targetId       String?      @db.Uuid
  limit          Float
