[TEMPLATE]
# -----------------------------------------------------------------------------
# ContextGraph - web app environment template
# Copy to `.env.local` and fill in real values. Never commit real secrets.
# -----------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
NODE_ENV=development
# Public base URL of the deployed application.
APP_URL=http://localhost:3000

# --- Backend API (NestJS) ----------------------------------------------------
# Base URL of the NestJS API (the `/api/v1` prefix is included). The dashboard
# health card and future API clients use this. The NestJS API itself has its
# own env file in apps/api — see apps/api/.env.example.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- Authentication (Clerk) --------------------------------------------------
# Get both keys from Clerk Dashboard -> API Keys. The publishable key starts
# with `pk_test_` (dev) or `pk_live_` (prod); the secret key is server-only
# and must never leak into client bundles or be committed.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
# Optional — where Clerk redirects for sign-in / sign-up. Defaults match the
# app's own routes, so these can be omitted.
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
